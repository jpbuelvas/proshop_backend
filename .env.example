# Entorno: en "development" TypeORM sincroniza el esquema automáticamente;
# en cualquier otro valor (ej. "production") NO lo hace (usar migraciones).
NODE_ENV=development
PORT=3001

# Base de datos (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=proshop_store

# Auth / JWT
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend (usado para CORS y para links en emails)
FRONTEND_URL=http://localhost:5173

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Wompi (pasarela de pagos)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Dropi (proveedor dropshipping)
DROPI_BASE_URL=
DROPI_API_KEY=

# WooCommerce (bridge/sync)
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Email (nodemailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SUPPORT_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
